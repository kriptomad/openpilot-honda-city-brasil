(version 1)
# JLCPCB 4-layer capability, adversarial review 2026-10-29 (numbers given by the reviewer brief)
(rule "JLC_track_width"
  (constraint track_width (min 0.09mm)))
(rule "JLC_clearance"
  (constraint clearance (min 0.09mm))
  (layer outer))
(rule "JLC_clearance_inner"
  (constraint clearance (min 0.09mm))
  (layer inner))
(rule "JLC_via_diameter"
  (constraint via_diameter (min 0.45mm)))
(rule "JLC_via_hole"
  (constraint hole_size (min 0.2mm))
  (condition "A.Type == 'Via'"))
(rule "JLC_annular"
  (constraint annular_width (min 0.13mm)))
(rule "JLC_hole_to_copper"
  (constraint hole_clearance (min 0.254mm)))
(rule "JLC_hole_to_hole"
  (constraint hole_to_hole (min 0.5mm)))
(rule "JLC_edge"
  (constraint edge_clearance (min 0.3mm)))
(rule "JLC_silk_text"
  (constraint text_height (min 0.8mm))
  (constraint text_thickness (min 0.15mm))
  (layer "?.Silkscreen"))
(rule "JLC_silk_line"
  (constraint silk_clearance (min 0.0mm))
  (layer "?.Silkscreen"))
